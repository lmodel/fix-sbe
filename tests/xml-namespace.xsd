<?xml version="1.0" encoding="UTF-8"?>
<!-- A stand-in for W3C's xml.xsd, which SBE 2.0's XSD imports from w3.org. It declares the one
     attribute that XSD uses, so tests/test_documents.py validates without a network. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace">
  <xs:attribute name="base" type="xs:anyURI"/>
</xs:schema>
