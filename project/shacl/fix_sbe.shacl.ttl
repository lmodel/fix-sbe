@prefix fix_sbe: <https://w3id.org/lmodel/fix-sbe/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fix_sbe:AlignmentAttributesV1 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Offset from start of a composite type or block as a zero-based index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:offset ] ;
    sh:targetClass fix_sbe:AlignmentAttributesV1 .

fix_sbe:AlignmentAttributesV2 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Byte alignment of the start of a block (message root or repeating group instance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:alignment ] ;
    sh:targetClass fix_sbe:AlignmentAttributesV2 .

fix_sbe:BlockTypeV1 a sh:NodeShape ;
    rdfs:comment "Base type of message and repeating group entry" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type fix_sbe:dimension_type ) ;
    sh:property [ sh:class fix_sbe:FieldTypeV1 ;
            sh:description "Variable-length fields" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_sbe:data ],
        [ sh:class fix_sbe:GroupTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_sbe:group ],
        [ sh:class fix_sbe:FieldTypeV1 ;
            sh:description "Fixed-length fields" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_sbe:field ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:semantic_type ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:name ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:since_version ],
        [ sh:datatype xsd:integer ;
            sh:description "Space reserved for root level of message, not include groups or variable-length data elements." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:block_length ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_sbe:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique ID of a message template" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:id ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_sbe:deprecated ] ;
    sh:targetClass fix_sbe:BlockTypeV1 .

fix_sbe:MessageSchemaV1 a sh:NodeShape ;
    rdfs:comment "Root of XML document, holds all message templates and their elements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_sbe:package ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique ID of a message schema" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:id ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of a message schema. Initial version is 0." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:version ],
        [ sh:class fix_sbe:MessageV1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_sbe:message ],
        [ sh:defaultValue "littleEndian" ;
            sh:in ( "bigEndian" "littleEndian" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path fix_sbe:byte_order ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:description ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:defaultValue "messageHeader"^^xsd:string ;
            sh:description "Name of the encoding type of the message header, which is the same for all messages in a schema. The name has a default, but an encoding of that name must be present under a 'types' element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:header_type ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:string ;
            sh:description "More than one set of types may be provided. Names must be unique across all encoding types. Encoding types may appear in any order." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:types ],
        [ sh:datatype xsd:string ;
            sh:description "Application layer specification version, such as FIX version 'FIX.5.0SP2'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:semantic_version ] ;
    sh:targetClass fix_sbe:MessageSchemaV1 .

fix_sbe:MessageSchemaV2 a sh:NodeShape ;
    rdfs:comment "Root of XML document, holds all message templates and their elements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fix_sbe:MessagesV2 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_sbe:messages ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:defaultValue "messageHeader"^^xsd:string ;
            sh:description "Name of the encoding type of the message header, which is the same for all messages in a schema. The name has a default, but an encoding of that name must be present under a 'types' element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:header_type ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:description ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of a message schema. Initial version is 0." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:version ],
        [ sh:defaultValue "littleEndian" ;
            sh:in ( "bigEndian" "littleEndian" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path fix_sbe:byte_order ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique ID of a message schema" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_sbe:package ],
        [ sh:class fix_sbe:TypesV2 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_sbe:types ],
        [ sh:datatype xsd:string ;
            sh:description "Application layer specification version, such as FIX version 'FIX.5.0SP2'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:semantic_version ] ;
    sh:targetClass fix_sbe:MessageSchemaV2 .

fix_sbe:OffsetAttributesV2 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Byte alignment of the start of a block (message root or repeating group instance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:alignment ],
        [ sh:datatype xsd:integer ;
            sh:description "Offset from start of a composite type or block as a zero-based index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:offset ] ;
    sh:targetClass fix_sbe:OffsetAttributesV2 .

fix_sbe:PresenceAttributesV1 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "required" ;
            sh:in ( "required" "optional" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path fix_sbe:presence ],
        [ sh:datatype fix_sbe:QualifiedName ;
            sh:description "A constant value as valid value of an enum in the form enum-name.valid-value-name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:value_ref ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*\\.([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ] ;
    sh:targetClass fix_sbe:PresenceAttributesV1 .

fix_sbe:PresenceAttributesV2 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Override of default null indicator for the data type in SBE specification, as a string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:null_value ],
        [ sh:datatype xsd:string ;
            sh:description "Lower bound of a range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_sbe:min_value ],
        [ sh:defaultValue "required" ;
            sh:in ( "required" "optional" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path fix_sbe:presence ],
        [ sh:datatype fix_sbe:QualifiedName ;
            sh:description "A constant value as valid value of an enum in the form enum-name.valid-value-name. Only valid if presence='constant'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:value_ref ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*\\.([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Upper bound of a range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:max_value ] ;
    sh:targetClass fix_sbe:PresenceAttributesV2 .

fix_sbe:PrimitiveTypeAttributesV2 a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "char" "int8" "int16" "int32" "int64" "uint8" "uint16" "uint32" "uint64" "float" "double" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path fix_sbe:primitive_type ],
        [ sh:datatype xsd:string ;
            sh:description "Character set or Unicode encoding scheme" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_sbe:character_encoding ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:length ] ;
    sh:targetClass fix_sbe:PrimitiveTypeAttributesV2 .

fix_sbe:SemanticAttributes a sh:NodeShape ;
    rdfs:comment "Application layer class. Maps a field to a FIX data type or a template to a FIX message." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:semantic_type ] ;
    sh:targetClass fix_sbe:SemanticAttributes .

fix_sbe:VersionAttributes a sh:NodeShape ;
    rdfs:comment "Schema versioning supports message extension" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:since_version ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:deprecated ] ;
    sh:targetClass fix_sbe:VersionAttributes .

fix_sbe:BlockTypeV2 a sh:NodeShape ;
    rdfs:comment "Base type of message and repeating group entry" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type fix_sbe:dimension_type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Space reserved for root level of message or repeating group, not including nested groups or variable-length data elements." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:block_length ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fix_sbe:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_sbe:semantic_type ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique ID of a message template" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:id ],
        [ sh:class fix_sbe:FieldTypeV2 ;
            sh:description "Variable-length fields" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_sbe:data ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:description ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:name ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_sbe:since_version ],
        [ sh:class fix_sbe:GroupTypeV2 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_sbe:group ],
        [ sh:class fix_sbe:FieldTypeV2 ;
            sh:description "Fixed-length fields" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_sbe:field ],
        [ sh:datatype xsd:integer ;
            sh:description "Byte alignment of the start of a block (message root or repeating group instance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:alignment ] ;
    sh:targetClass fix_sbe:BlockTypeV2 .

fix_sbe:CompositeDataTypeV1 a sh:NodeShape ;
    rdfs:comment "A wire encoding composed of multiple parts" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fix_sbe:EncodedDataTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_sbe:type ],
        [ sh:datatype xsd:string ;
            sh:description "Text content of the element. For SBE this carries the constant or default value (e.g. ``<type presence='constant'>-3</type>``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:semantic_type ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:name ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fix_sbe:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_sbe:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Offset from start of a composite type or block as a zero-based index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_sbe:offset ],
        [ sh:class fix_sbe:RefTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fix_sbe:ref ],
        [ sh:class fix_sbe:EnumTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_sbe:enum ],
        [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fix_sbe:since_version ],
        [ sh:class fix_sbe:SetTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_sbe:set ],
        [ sh:class fix_sbe:CompositeDataTypeV1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fix_sbe:composite ] ;
    sh:targetClass fix_sbe:CompositeDataTypeV1 .

fix_sbe:EncodedDataTypeV1 a sh:NodeShape ;
    rdfs:comment "Simple wire encoding consisting of a primitive type or array of primitives" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fix_sbe:since_version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fix_sbe:description ],
        [ sh:defaultValue "required" ;
            sh:in ( "required" "optional" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fix_sbe:presence ],
        [ sh:datatype xsd:string ;
            sh:description "Text content of the element. For SBE this carries the constant or default value (e.g. ``<type presence='constant'>-3</type>``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_sbe:value ],
        [ sh:datatype xsd:string ;
            sh:description "Override of default null indicator for the data type in SBE specification, as a string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:null_value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_sbe:min_value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fix_sbe:semantic_type ],
        [ sh:datatype fix_sbe:QualifiedName ;
            sh:description "A constant value as valid value of an enum in the form enum-name.valid-value-name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fix_sbe:value_ref ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*\\.([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:max_value ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_sbe:name ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:in ( "char" "int8" "int16" "int32" "int64" "uint8" "uint16" "uint32" "uint64" "float" "double" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path fix_sbe:primitive_type ],
        [ sh:datatype xsd:integer ;
            sh:description "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fix_sbe:deprecated ],
        [ sh:datatype xsd:integer ;
            sh:description "Offset from start of a composite type or block as a zero-based index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_sbe:offset ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_sbe:character_encoding ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_sbe:length ] ;
    sh:targetClass fix_sbe:EncodedDataTypeV1 .

fix_sbe:EnumTypeV1 a sh:NodeShape ;
    rdfs:comment "An enumeration of valid values" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Text content of the element. For SBE this carries the constant or default value (e.g. ``<type presence='constant'>-3</type>``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_sbe:value ],
        [ sh:datatype fix_sbe:SymbolicName ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_sbe:name ;
            sh:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ],
        [ sh:class fix_sbe:ValidValue ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_sbe:valid_value ],
        [ sh:datatype xsd:integer ;
            sh:description "The schema version in which an element was added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_sbe:since_version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_sbe:semantic_type ],
