    skos:inScheme fix_sbe:common ;
    fix_sbe:xsd_simple_extension "xs:token" .

fix_sbe:deprecated a owl:DatatypeProperty ;
    rdfs:label "deprecated" ;
    skos:definition "The version of the schema in which an element was deprecated. It is retained for back compatibility but should no longer be used by updated applications. It may be removed in a later version." ;
    skos:exactMatch sbe_v2:deprecated ;
    skos:inScheme fix_sbe:common .

fix_sbe:epoch a owl:DatatypeProperty ;
    rdfs:label "epoch" ;
    skos:exactMatch sbe_v1:epoch ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:semantic_type a owl:DatatypeProperty ;
    rdfs:label "semantic_type" ;
    skos:altLabel "semanticType" ;
    skos:exactMatch sbe_v2:semanticType ;
    skos:inScheme fix_sbe:common .

fix_sbe:since_version a owl:DatatypeProperty ;
    rdfs:label "since_version" ;
    skos:altLabel "sinceVersion" ;
    skos:definition "The schema version in which an element was added" ;
    skos:exactMatch sbe_v2:sinceVersion ;
    skos:inScheme fix_sbe:common .

fix_sbe:time_unit a owl:DatatypeProperty ;
    rdfs:label "time_unit" ;
    skos:altLabel "timeUnit" ;
    skos:definition "Deprecated - only for back compatibility with RC2" ;
    skos:exactMatch sbe_v1:timeUnit ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:ByteOrder a owl:Class ;
    rdfs:label "ByteOrder" ;
    owl:unionOf ( <https://w3id.org/lmodel/fix-sbe/ByteOrder#bigEndian> <https://w3id.org/lmodel/fix-sbe/ByteOrder#littleEndian> ) ;
    skos:definition "Inline enumeration lifted from XSD attribute ``byteOrder`` on ``messageSchema``." ;
    skos:inScheme fix_sbe:common ;
    linkml:permissible_values <https://w3id.org/lmodel/fix-sbe/ByteOrder#bigEndian>,
        <https://w3id.org/lmodel/fix-sbe/ByteOrder#littleEndian> .

