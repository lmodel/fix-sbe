        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int32>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int64>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int8>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint16>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint32>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint64>,
        <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint8> .

fix_sbe:PrimitiveTypeV2 a owl:Class ;
    rdfs:label "PrimitiveTypeV2" ;
