@prefix dct: <http://purl.org/dc/terms/> .
@prefix fix_sbe: <https://w3id.org/lmodel/fix-sbe/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sbe_v1: <http://fixprotocol.io/2016/sbe/> .
@prefix sbe_v2: <http://fixprotocol.io/2017/sbe/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/fix-sbe.owl.ttl> a owl:Ontology ;
    rdfs:label "fix_sbe" ;
    dct:license "Apache-2.0" ;
    dct:source <https://github.com/FIXTradingCommunity/fix-simple-binary-encoding> ;
    dct:title "FIX Simple Binary Encoding" ;
    rdfs:seeAlso <https://github.com/FIXTradingCommunity/fix-simple-binary-encoding>,
        <https://lmodel.github.io/fix-simple-binary-encoding>,
        <https://www.fixtrading.org/standards/sbe/> ;
    skos:definition "Umbrella LinkML schema for the FIX Simple Binary Encoding (SBE) standard. Imports three overlays: ``fix_sbe_common`` (entities structurally identical across SBE versions, kept unsuffixed) plus two per-version overlays ``fix_sbe_v1_0`` and ``fix_sbe_v2_0`` (remaining version-specific entities, PascalCase names suffixed with ``V1`` or ``V2`` to disambiguate). Per-version validation can be performed by targeting an overlay file directly." ;
    skos:editorialNote "(c) Copyright 2014-2019 FIX Protocol Limited. Creative Commons Attribution-NoDerivatives 4.0 International Public License (CC BY-ND 4.0) applies to the upstream XSD specifications.",
        "This umbrella schema is auto-generated by scripts/schema_to_linkml.py - do not edit this file by hand." ;
    fix_sbe:xsd_target_namespace_sbe_v1 "http://fixprotocol.io/2016/sbe" ;
    fix_sbe:xsd_target_namespace_sbe_v2 "http://fixprotocol.io/2017/sbe" .

fix_sbe:MessageSchemaV1 a owl:Class ;
    rdfs:label "MessageSchemaV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:types ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:MessageV1 ;
            owl:onProperty fix_sbe:message ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:types ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:ByteOrder ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:message ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:id ] ;
    skos:altLabel "messageSchema" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/Repository> ;
    skos:definition "Root of XML document, holds all message templates and their elements" ;
    skos:exactMatch sbe_v1:messageSchema,
        fix_sbe:MessageSchemaV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:MessageSchemaV2 a owl:Class ;
    rdfs:label "MessageSchemaV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:messages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:MessagesV2 ;
            owl:onProperty fix_sbe:messages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:TypesV2 ;
            owl:onProperty fix_sbe:types ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:types ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:semantic_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:ByteOrder ;
            owl:onProperty fix_sbe:byte_order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:header_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:package ] ;
    skos:altLabel "messageSchema" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/Repository> ;
    skos:definition "Root of XML document, holds all message templates and their elements" ;
    skos:exactMatch sbe_v2:messageSchema,
        fix_sbe:MessageSchemaV2 ;
    skos:inScheme fix_sbe:v2_0 .

fix_sbe:AlignmentAttributesV2 a owl:Class ;
    rdfs:label "AlignmentAttributesV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:alignment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:alignment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:alignment ] ;
    skos:altLabel "alignmentAttributes" ;
    skos:exactMatch sbe_v2:alignmentAttributes,
        fix_sbe:AlignmentAttributesV2 ;
    skos:inScheme fix_sbe:v2_0 .

<https://w3id.org/lmodel/fix-sbe/ByteOrder#bigEndian> a owl:Class ;
    rdfs:label "bigEndian" ;
    rdfs:subClassOf fix_sbe:ByteOrder .

<https://w3id.org/lmodel/fix-sbe/ByteOrder#littleEndian> a owl:Class ;
    rdfs:label "littleEndian" ;
    rdfs:subClassOf fix_sbe:ByteOrder .

fix_sbe:CompositeDataTypeV1 a owl:Class ;
    rdfs:label "CompositeDataTypeV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:EncodedDataTypeV1 ;
            owl:onProperty fix_sbe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:composite ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:EnumTypeV1 ;
            owl:onProperty fix_sbe:enum ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:CompositeDataTypeV1 ;
            owl:onProperty fix_sbe:composite ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:enum ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SetTypeV1 ;
            owl:onProperty fix_sbe:set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:RefTypeV1 ;
            owl:onProperty fix_sbe:ref ],
        fix_sbe:AlignmentAttributesV1,
        fix_sbe:SemanticAttributes,
        fix_sbe:VersionAttributes ;
    skos:altLabel "compositeDataType" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/Datatype> ;
    skos:definition "A wire encoding composed of multiple parts" ;
    skos:exactMatch sbe_v1:compositeDataType,
        fix_sbe:CompositeDataTypeV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:EncodedDataTypeV1 a owl:Class ;
    rdfs:label "EncodedDataTypeV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:null_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:character_encoding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:min_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:PrimitiveTypeV1 ;
            owl:onProperty fix_sbe:primitive_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:null_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:null_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:max_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:character_encoding ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:primitive_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:max_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:length ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:character_encoding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:primitive_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:min_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:max_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:min_value ],
        fix_sbe:AlignmentAttributesV1,
        fix_sbe:PresenceAttributesV1,
        fix_sbe:SemanticAttributes,
        fix_sbe:VersionAttributes ;
    skos:altLabel "encodedDataType" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/Datatype> ;
    skos:definition "Simple wire encoding consisting of a primitive type or array of primitives" ;
    skos:exactMatch sbe_v1:encodedDataType,
        fix_sbe:EncodedDataTypeV1 ;
    skos:inScheme fix_sbe:v1_0 ;
    fix_sbe:xsd_simple_extension "xs:token" .

fix_sbe:EnumTypeV1 a owl:Class ;
    rdfs:label "EnumTypeV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:ValidValue ;
            owl:onProperty fix_sbe:valid_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:valid_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:encoding_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:encoding_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:encoding_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:value ],
        fix_sbe:AlignmentAttributesV1,
        fix_sbe:SemanticAttributes,
        fix_sbe:VersionAttributes ;
    skos:altLabel "enumType" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/CodeSetType> ;
    skos:definition "An enumeration of valid values" ;
    skos:exactMatch sbe_v1:enumType,
        fix_sbe:EnumTypeV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:GroupTypeV1 a owl:Class ;
    rdfs:label "GroupTypeV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:dimension_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:dimension_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:dimension_type ],
        fix_sbe:BlockTypeV1 ;
    skos:altLabel "groupType" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/ComponentType> ;
    skos:definition "A repeating group contains an array of entries" ;
    skos:exactMatch sbe_v1:groupType,
        fix_sbe:GroupTypeV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:GroupTypeV2 a owl:Class ;
    rdfs:label "GroupTypeV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:dimension_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:dimension_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:dimension_type ],
        fix_sbe:BlockTypeV2 ;
    skos:altLabel "groupType" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/ComponentType> ;
    skos:definition "A repeating group contains an array of entries" ;
    skos:exactMatch sbe_v2:groupType,
        fix_sbe:GroupTypeV2 ;
    skos:inScheme fix_sbe:v2_0 .

fix_sbe:MemberDataTypeV2 a owl:Class ;
    rdfs:label "MemberDataTypeV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:SymbolicName ;
            owl:onProperty fix_sbe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:value ],
        fix_sbe:OffsetAttributesV2,
        fix_sbe:PresenceAttributesV2,
        fix_sbe:PrimitiveTypeAttributesV2 ;
    skos:altLabel "memberDataType" ;
    skos:definition "A simple type used as a member of a composite type" ;
    skos:exactMatch sbe_v2:memberDataType,
        fix_sbe:MemberDataTypeV2 ;
    skos:inScheme fix_sbe:v2_0 ;
    skos:narrowMatch <https://w3id.org/lmodel/fix-orchestra/Datatype> ;
    fix_sbe:xsd_simple_extension "xs:token" .

fix_sbe:MessageV1 a owl:Class ;
    rdfs:label "MessageV1" ;
    rdfs:subClassOf fix_sbe:BlockTypeV1 ;
    skos:altLabel "message" ;
    skos:definition "A message type, also known as a message template" ;
    skos:exactMatch sbe_v1:message,
        <https://w3id.org/lmodel/fix-orchestra/MessageType>,
        fix_sbe:MessageV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:MessagesV2 a owl:Class ;
    rdfs:label "MessagesV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:package ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_sbe:BlockTypeV2 ;
            owl:onProperty fix_sbe:message ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_sbe:message ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:package ] ;
    skos:altLabel "messages" ;
    skos:exactMatch sbe_v2:messages,
        <https://w3id.org/lmodel/fix-orchestra/Messages>,
        fix_sbe:MessagesV2 ;
    skos:inScheme fix_sbe:v2_0 .

<https://w3id.org/lmodel/fix-sbe/Presence#constant> a owl:Class ;
    rdfs:label "constant" ;
    rdfs:subClassOf fix_sbe:Presence ;
    skos:definition "Value does not vary so it need not be serialized on the wire" .

<https://w3id.org/lmodel/fix-sbe/Presence#optional> a owl:Class ;
    rdfs:label "optional" ;
    rdfs:subClassOf fix_sbe:Presence ;
    skos:definition "Value may be set to nullValue for its data type" .

<https://w3id.org/lmodel/fix-sbe/Presence#required> a owl:Class ;
    rdfs:label "required" ;
    rdfs:subClassOf fix_sbe:Presence ;
    skos:definition "The value must always be populated" .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#char> a owl:Class ;
    rdfs:label "char" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#double> a owl:Class ;
    rdfs:label "double" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#float> a owl:Class ;
    rdfs:label "float" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int16> a owl:Class ;
    rdfs:label "int16" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int32> a owl:Class ;
    rdfs:label "int32" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int64> a owl:Class ;
    rdfs:label "int64" ;
    rdfs:subClassOf fix_sbe:PrimitiveTypeV1 .

<https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int8> a owl:Class ;
