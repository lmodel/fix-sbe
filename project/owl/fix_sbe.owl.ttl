        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:semantic_type ] ;
    skos:altLabel "semanticAttributes" ;
    skos:definition "Application layer class. Maps a field to a FIX data type or a template to a FIX message." ;
    skos:exactMatch sbe_v1:semanticAttributes,
        sbe_v2:semanticAttributes,
        fix_sbe:SemanticAttributes ;
    skos:inScheme fix_sbe:common .

fix_sbe:PrimitiveTypeV1 a owl:Class ;
    rdfs:label "PrimitiveTypeV1" ;
    owl:unionOf ( <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#char> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int8> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int16> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int32> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#int64> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint8> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint16> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint32> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#uint64> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#float> <https://w3id.org/lmodel/fix-sbe/PrimitiveTypeV1#double> ) ;
