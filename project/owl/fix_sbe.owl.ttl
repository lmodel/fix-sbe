<https://w3id.org/lmodel/fix-sbe.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/FIXTradingCommunity/fix-simple-binary-encoding> ;
	dcterms:title "FIX Simple Binary Encoding (SBE)" ;
	pav:version "1.0 and 2.0-rc3" ;
	schema1:keywords "FIX" , "SBE" , "binary encoding" , "message schema" , "wire format" ;
	a owl:Ontology ;
	rdfs:label "fix_sbe" ;
	rdfs:seeAlso <https://github.com/FIXTradingCommunity/fix-simple-binary-encoding> , <https://lmodel.github.io/fix-sbe> , <https://www.iana.org/assignments/media-types/application/sbe> ;
	skos:definition "A LinkML model of FIX Simple Binary Encoding, a standard from the FIX Trading Community for encoding messages in binary. It describes SBE message schemas: encodings, message templates, fields, groups and variable-length data. The two editions differ on the wire and in their XML, so each has a module of its own." ;
	skos:note "A document of SBE 1.0 starts at SbeMessageSchemaV1, the tree root, and one of SBE 2.0 RC3 at SbeMessageSchemaV2. upstream/ holds both XSDs unchanged, tests/test_coverage.py holds the modules to them, and scripts/check_upstream_release.py reports when either moves." ;
	fix_sbe:upstream_v1_commit "6321e6b9bce5bc198f88f462054cbaf4f33d8f60" ;
	fix_sbe:upstream_v1_tag "v1.0-errata-Nov-2020" ;
	fix_sbe:upstream_v2_commit "418a8f6a8b93c65b308638dab2bc6a35dddcd864" .
fix_sbe:SbeBlockV1 a owl:Class ;
	rdfs:label "SbeBlockV1" ;
	rdfs:subClassOf fix_sbe:SbeVersionedMixin , _:c14n107 , _:c14n131 , _:c14n142 , _:c14n168 , _:c14n171 , _:c14n189 , _:c14n210 , _:c14n268 , _:c14n286 , _:c14n308 , _:c14n33 , _:c14n332 , _:c14n369 , _:c14n386 , _:c14n403 , _:c14n426 , _:c14n459 , _:c14n467 , _:c14n57 , _:c14n73 , _:c14n80 , _:c14n81 ;
	skos:definition "The body shared by a message and a group entry, which holds its fixed-length fields first, then groups, then variable-length data." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_v1_0 .
fix_sbe:SbeBlockV2 a owl:Class ;
	rdfs:label "SbeBlockV2" ;
	rdfs:subClassOf fix_sbe:SbeVersionedMixin , _:c14n129 , _:c14n164 , _:c14n169 , _:c14n207 , _:c14n234 , _:c14n244 , _:c14n255 , _:c14n269 , _:c14n314 , _:c14n320 , _:c14n341 , _:c14n345 , _:c14n351 , _:c14n374 , _:c14n377 , _:c14n379 , _:c14n39 , _:c14n393 , _:c14n409 , _:c14n428 , _:c14n451 , _:c14n452 , _:c14n84 , _:c14n92 , _:c14n98 ;
	skos:definition "The body shared by a message and a group entry, which holds its fixed-length fields first, then groups, then variable-length data." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_v2_0 .
fix_sbe:SbeByteOrder\#bigEndian a owl:Class ;
	rdfs:label "bigEndian" ;
	rdfs:subClassOf fix_sbe:SbeByteOrder ;
	skos:definition "The most significant octet comes first." .
fix_sbe:SbeByteOrder\#littleEndian a owl:Class ;
	rdfs:label "littleEndian" ;
	rdfs:subClassOf fix_sbe:SbeByteOrder ;
	skos:definition "The least significant octet comes first." .
fix_sbe:SbeByteOrder a owl:Class ;
	rdfs:label "SbeByteOrder" ;
	owl:unionOf _:c14n305 ;
	skos:definition "The order of the octets in every multi-octet number of a message." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_common ;
	linkml:permissible_values fix_sbe:SbeByteOrder\#bigEndian , fix_sbe:SbeByteOrder\#littleEndian ;
	fix_sbe:sbe_section "4: messageSchema attributes" .
fix_sbe:SbeChoice a owl:Class ;
	rdfs:label "SbeChoice" ;
	rdfs:subClassOf fix_sbe:SbeVersionedMixin , _:c14n102 , _:c14n14 , _:c14n150 , _:c14n198 , _:c14n238 , _:c14n25 , _:c14n261 , _:c14n355 , _:c14n417 ;
	skos:definition "One of the alternatives of a set, which is one bit of its encoding." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_common ;
	skos:note "FIX's transposer does not carry a set to Orchestra, so the mapping is related. FIX's MultipleCharValue and MultipleStringValue fields hold such choices in a code set." ;
	skos:relatedMatch fix_orchestra:OrchestraCodeV10 ;
	fix_sbe:xsd_type "choice" .
fix_sbe:SbeCompositeV1 a owl:Class ;
	rdfs:label "SbeCompositeV1" ;
	rdfs:subClassOf fix_sbe:SbeEncodingV1 , _:c14n249 , _:c14n434 ;
	skos:closeMatch fix_orchestra:OrchestraComponentV10 ;
	skos:definition "An encoding built from members sent one after another, such as a decimal's mantissa and exponent." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_v1_0 ;
	skos:note "The members keep one list because their order is the order on the wire. Separate lists per kind of member could not say that an enum comes between two types." ;
	fix_sbe:xml_element "composite" ;
	fix_sbe:xsd_type "compositeDataType" .
fix_sbe:SbeCompositeV2 a owl:Class ;
	rdfs:label "SbeCompositeV2" ;
	rdfs:subClassOf fix_sbe:SbeMemberV2 , fix_sbe:SbeVersionedMixin , _:c14n125 , _:c14n306 ;
	skos:closeMatch fix_orchestra:OrchestraComponentV10 ;
	skos:definition "An encoding built from members sent one after another, such as a decimal's mantissa and exponent." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_v2_0 ;
	skos:note "The members keep one list because their order is the order on the wire. Separate lists per kind of member could not say that an enum comes between two types." ;
	fix_sbe:xml_element "composite" ;
	fix_sbe:xsd_type "compositeDataType" .
fix_sbe:SbeElementV2 a owl:Class ;
