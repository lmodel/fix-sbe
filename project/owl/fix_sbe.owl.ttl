fix_sbe:AlignmentAttributesV1 a owl:Class ;
    rdfs:label "AlignmentAttributesV1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:offset ] ;
    skos:altLabel "alignmentAttributes" ;
    skos:exactMatch sbe_v1:alignmentAttributes,
        fix_sbe:AlignmentAttributesV1 ;
    skos:inScheme fix_sbe:v1_0 .

fix_sbe:OffsetAttributesV2 a owl:Class ;
    rdfs:label "OffsetAttributesV2" ;
    rdfs:subClassOf [ a owl:Restriction ;
