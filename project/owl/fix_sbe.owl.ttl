	owl:unionOf _:c14n324 ;
	skos:definition "The FIX datatypes the specification's summary table lists as a field's or an encoding's semantic type." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_common ;
	skos:note "semantic_type stays free text in the schema, because a message's holds a MsgType value and the specification suggests matching names without regard to case. tests/sbe_rules.py holds an encoding's and a field's to this list." ;
	linkml:permissible_values fix_sbe:SbeFixDatatype\#Amt , fix_sbe:SbeFixDatatype\#Boolean , fix_sbe:SbeFixDatatype\#Country , fix_sbe:SbeFixDatatype\#Currency , fix_sbe:SbeFixDatatype\#DayOfMonth , fix_sbe:SbeFixDatatype\#EncodedText , fix_sbe:SbeFixDatatype\#Exchange , fix_sbe:SbeFixDatatype\#Language , fix_sbe:SbeFixDatatype\#Length , fix_sbe:SbeFixDatatype\#LocalMktDate , fix_sbe:SbeFixDatatype\#MonthYear , fix_sbe:SbeFixDatatype\#MultipleCharValue , fix_sbe:SbeFixDatatype\#MultipleStringValue , fix_sbe:SbeFixDatatype\#NumInGroup , fix_sbe:SbeFixDatatype\#Percentage , fix_sbe:SbeFixDatatype\#Price , fix_sbe:SbeFixDatatype\#PriceOffset , fix_sbe:SbeFixDatatype\#Qty , fix_sbe:SbeFixDatatype\#SeqNum , fix_sbe:SbeFixDatatype\#String , fix_sbe:SbeFixDatatype\#TZTimeOnly , fix_sbe:SbeFixDatatype\#TZTimestamp , fix_sbe:SbeFixDatatype\#TagNum , fix_sbe:SbeFixDatatype\#UTCDateOnly , fix_sbe:SbeFixDatatype\#UTCTimeOnly , fix_sbe:SbeFixDatatype\#UTCTimestamp , fix_sbe:SbeFixDatatype\#XMLData , fix_sbe:SbeFixDatatype\#char , fix_sbe:SbeFixDatatype\#data , fix_sbe:SbeFixDatatype\#float , fix_sbe:SbeFixDatatype\#int ;
	fix_sbe:sbe_section "2: FIX datatype summary" .
