	skos:closeMatch fix_orchestra:OrchestraFieldV10 ;
	skos:definition "A message's or group entry's field, which uses an encoding at a place in its block." ;
	skos:inScheme fix_sbe:schema\/fix_sbe_v1_0 ;
	skos:note "The old mapping called this an exact match of an Orchestra field, but the two differ. This one sits at a place in one block, and FIX's transposer carries one with a composite encoding to a component reference, not a field." ;
	fix_sbe:xml_element "field" ;
	fix_sbe:xsd_type "fieldType" .
