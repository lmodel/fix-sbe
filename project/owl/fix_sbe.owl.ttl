fix_sbe:SemanticAttributes a owl:Class ;
    rdfs:label "SemanticAttributes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:semantic_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:description ],
        [ a owl:Restriction ;
