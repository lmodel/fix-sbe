fix_sbe:encoding_type a owl:DatatypeProperty .

fix_sbe:package a owl:DatatypeProperty .

fix_sbe:VersionAttributes a owl:Class ;
    rdfs:label "VersionAttributes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:since_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:deprecated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:deprecated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_sbe:deprecated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fix_sbe:since_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_sbe:since_version ] ;
    skos:altLabel "versionAttributes" ;
    skos:closeMatch <https://w3id.org/lmodel/fix-orchestra/EntityAttribGrp> ;
    skos:definition "Schema versioning supports message extension" ;
    skos:exactMatch sbe_v1:versionAttributes,
        sbe_v2:versionAttributes,
        fix_sbe:VersionAttributes ;
    skos:inScheme fix_sbe:common .

fix_sbe:id a owl:DatatypeProperty .

fix_sbe:type a owl:DatatypeProperty,
        owl:ObjectProperty .

fix_sbe:SymbolicName a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "([A-Z]|[a-z]|_)([0-9]|[A-Z]|[a-z]|_)*" ] ) ] ) ] .

fix_sbe:description a owl:DatatypeProperty .

fix_sbe:value a owl:DatatypeProperty .

fix_sbe:name a owl:DatatypeProperty .


