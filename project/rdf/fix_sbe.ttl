	schema1:keywords "FIX" , "SBE" , "binary encoding" , "message schema" , "wire format" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/FIXTradingCommunity/fix-simple-binary-encoding"^^xsd:anyURI , "https://lmodel.github.io/fix-sbe"^^xsd:anyURI , "https://www.iana.org/assignments/media-types/application/sbe"^^xsd:anyURI ;
	skos:note "A document of SBE 1.0 starts at SbeMessageSchemaV1, the tree root, and one of SBE 2.0 RC3 at SbeMessageSchemaV2. upstream/ holds both XSDs unchanged, tests/test_coverage.py compares the modules with them, and scripts/check_upstream_release.py reports when either changes." ;
