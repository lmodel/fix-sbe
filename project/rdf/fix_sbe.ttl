<https://w3id.org/lmodel/fix-sbe/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-sbe/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-sbe/valid_value> a linkml:SlotDefinition ;
	linkml:annotations _:c14n13 , _:c14n95 ;
	linkml:description "The value as it is written in the schema, which must convert to the enumeration's encoding." ;
	linkml:pattern "^\\S+( \\S+)*$" ;
	linkml:range <https://w3id.org/lmodel/fix-sbe/SbeToken> ;
	linkml:required true .
<https://w3id.org/lmodel/fix-sbe/valid_values> a linkml:SlotDefinition ;
	skos:altLabel "validValue" ;
	skos:inScheme "https://w3id.org/lmodel/fix-sbe/schema/fix_sbe_common"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-sbe/valid_values"^^xsd:anyURI ;
	linkml:description "The values this enumeration allows." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-sbe/SbeEnumV1> , <https://w3id.org/lmodel/fix-sbe/SbeEnumV2> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/fix-sbe/SbeEnumV2> ;
	linkml:range <https://w3id.org/lmodel/fix-sbe/SbeValidValue> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-sbe/valid_values"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-sbe/value_ref> a linkml:SlotDefinition ;
	skos:altLabel "valueRef" ;
