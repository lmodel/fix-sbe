<EncodedDataTypeV1> CLOSED {
    (  $<EncodedDataTypeV1_tes> (  &<AlignmentAttributesV1_tes> ;
          rdf:type [ <AlignmentAttributesV1> ] ? ;
          &<PresenceAttributesV1_tes> ;
          rdf:type [ <PresenceAttributesV1> ] ? ;
          &<SemanticAttributes_tes> ;
