}

<SbeMemberV1>  (
    @<SbeEncodingV1> OR @<SbeRefV1>
)

<SbeMemberV1_struct> {
    (  $<SbeMemberV1_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <encoding_kind> @linkml:String ;
          <symbolic_name> @<SbeSymbolicName> ;
          <offset> @linkml:Integer ? ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeMemberV1> ] ?
    )
}

<SbeMemberV2>  (
    @<SbeCompositeV2> OR @<SbeEnumV2> OR @<SbeMemberTypeV2> OR @<SbeRefV2> OR @<SbeSetV2>
)

<SbeMemberV2_struct> {
    (  $<SbeMemberV2_tes> (  &<SbeElementV2_tes> ;
          rdf:type [ <SbeElementV2> ] ? ;
          <offset> @linkml:Integer ? ;
          <alignment> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeMemberV2> ] ?
    )
}

<SbeMessageSchemaV1> CLOSED {
    (  $<SbeMessageSchemaV1_tes> (  <schema_package> @linkml:String ? ;
          <sbe_id> @linkml:Integer ? ;
          <schema_version> @linkml:Integer ;
          <semantic_version> @linkml:String ? ;
          schema1:description @linkml:String ? ;
          <byte_order> [ <https://w3id.org/lmodel/fix-sbe/SbeByteOrder#bigEndian>
             <https://w3id.org/lmodel/fix-sbe/SbeByteOrder#littleEndian> ] ? ;
          <header_type> @<SbeSymbolicName> ? ;
          <encoding_sets> @<SbeEncodingSetV1> + ;
          <messages> @<SbeMessageV1> +
       ) ;
       rdf:type [ <SbeMessageSchemaV1> ] ?
    )
}

<SbeMessageSchemaV2> CLOSED {
    (  $<SbeMessageSchemaV2_tes> (  <schema_package> @linkml:String ? ;
          <sbe_id> @linkml:Integer ? ;
          <schema_version> @linkml:Integer ;
          <semantic_version> @linkml:String ? ;
          schema1:description @linkml:String ? ;
          <byte_order> [ <https://w3id.org/lmodel/fix-sbe/SbeByteOrder#bigEndian>
             <https://w3id.org/lmodel/fix-sbe/SbeByteOrder#littleEndian> ] ? ;
          <header_type> @<SbeSymbolicName> ? ;
          <encoding_sets> @<SbeEncodingSetV2> + ;
          <message_sets> @<SbeMessageSetV2> +
       ) ;
       rdf:type [ <SbeMessageSchemaV2> ] ?
    )
}

<SbeMessageSetV2> CLOSED {
    (  $<SbeMessageSetV2_tes> (  schema1:description @linkml:String ? ;
          <schema_package> @linkml:String ? ;
          <sbe_xml_base> @linkml:String ? ;
          <messages> @<SbeMessageV2> +
       ) ;
       rdf:type [ <SbeMessageSetV2> ] ?
    )
}

<SbeMessageV1> CLOSED {
    (  $<SbeMessageV1_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          &<SbeBlockV1Mixin_tes> ;
          rdf:type [ <SbeBlockV1Mixin> ] ? ;
          <sbe_id> @linkml:Integer ;
          <semantic_type> @<SbeToken> ? ;
