          rdf:type [ <SbeBlockV1Mixin> ] ? ;
          <dimension_type> @<SbeSymbolicName> ? ;
          <block_fields> @<SbeFieldV1> + ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <block_length> @linkml:Integer ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <repeating_groups> @<SbeGroupV1> * ;
          <var_data_fields> @<SbeFieldV1> *
       ) ;
       rdf:type [ <SbeGroupV1> ] ?
    )
}

<SbeGroupV2> CLOSED {
    (  $<SbeGroupV2_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          &<SbeBlockV2Mixin_tes> ;
          rdf:type [ <SbeBlockV2Mixin> ] ? ;
          <dimension_type> @<SbeSymbolicName> ? ;
          <block_fields> @<SbeFieldV2> + ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <block_length> @linkml:Integer ? ;
          <alignment> @linkml:Integer ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <repeating_groups> @<SbeGroupV2> * ;
          <var_data_fields> @<SbeFieldV2> *
       ) ;
       rdf:type [ <SbeGroupV2> ] ?
    )
}

<SbeMemberTypeV2> CLOSED {
    (  $<SbeMemberTypeV2_tes> (  &<SbeMemberV2_tes> ;
          rdf:type [ <SbeMemberV2> ] ? ;
          <element_value> @<SbeToken> ? ;
          <primitive_type> [ <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#char>
             <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#int8> <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#int16>
             <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#int32> <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#int64>
             <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#uint8> <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#uint16>
             <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#uint32> <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#uint64>
             <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#float> <https://w3id.org/lmodel/fix-sbe/SbePrimitiveType#double> ] ;
          <array_length> @linkml:Integer ? ;
          <character_encoding> @linkml:String ? ;
          <presence> [ <https://w3id.org/lmodel/fix-sbe/SbePresence#required>
             <https://w3id.org/lmodel/fix-sbe/SbePresence#optional> <https://w3id.org/lmodel/fix-sbe/SbePresence#constant> ] ? ;
          <null_value> @linkml:String ? ;
          <min_value> @linkml:String ? ;
          <max_value> @linkml:String ? ;
          <value_ref> @<SbeQualifiedName> ?
       ) ;
       rdf:type [ <SbeMemberTypeV2> ] ?
