          <presence> [ <https://w3id.org/lmodel/fix-sbe/Presence#required> <https://w3id.org/lmodel/fix-sbe/Presence#optional>
             <https://w3id.org/lmodel/fix-sbe/Presence#constant> ] ? ;
          <value_ref> @<QualifiedName> ? ;
          <semantic_type> @linkml:String ? ;
          <description> @linkml:String ? ;
          <since_version> @linkml:Integer ? ;
          <deprecated> @linkml:Integer ?
