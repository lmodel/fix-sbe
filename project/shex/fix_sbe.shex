<MessageSchemaV1> CLOSED {
    (  $<MessageSchemaV1_tes> (  <types> @linkml:String + ;
          <message> @<MessageV1> + ;
          <package> @linkml:String ? ;
          <id> @linkml:Integer ? ;
          <version> @linkml:Integer ;
          <semantic_version> @linkml:String ? ;
          <description> @linkml:String ? ;
