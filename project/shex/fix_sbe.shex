          <deprecated_since> @linkml:Integer ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <block_length> @linkml:Integer ? ;
          schema1:description @linkml:String ? ;
          <block_fields> @<SbeFieldV1> * ;
          <repeating_groups> @<SbeGroupV1> * ;
          <var_data_fields> @<SbeFieldV1> *
       ) ;
       rdf:type [ <SbeMessageV1> ] ?
    )
}

<SbeMessageV2> CLOSED {
    (  $<SbeMessageV2_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          &<SbeBlockV2Mixin_tes> ;
          rdf:type [ <SbeBlockV2Mixin> ] ? ;
          <sbe_id> @linkml:Integer ;
          <semantic_type> @<SbeToken> ? ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <block_length> @linkml:Integer ? ;
          <alignment> @linkml:Integer ? ;
          schema1:description @linkml:String ? ;
          <block_fields> @<SbeFieldV2> * ;
          <repeating_groups> @<SbeGroupV2> * ;
          <var_data_fields> @<SbeFieldV2> *
       ) ;
       rdf:type [ <SbeMessageV2> ] ?
    )
}

<SbeRefV1> CLOSED {
    (  $<SbeRefV1_tes> (  &<SbeMemberV1_tes> ;
          rdf:type [ <SbeMemberV1> ] ? ;
          <encoding_name> @<SbeSymbolicName>
       ) ;
       rdf:type [ <SbeRefV1> ] ?
    )
}

<SbeRefV2> CLOSED {
