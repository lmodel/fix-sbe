# metamodel_version: 1.12.0
# version: 1.0 and 2.0-rc3
BASE <https://w3id.org/lmodel/fix-sbe/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<SbeSymbolicName> xsd:string

<SbeQualifiedName> xsd:string

<SbeToken> xsd:token

<SbeBlockV1Mixin> {
    (  $<SbeBlockV1Mixin_tes> (  <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <block_length> @linkml:Integer ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <block_fields> @<SbeFieldV1> * ;
          <repeating_groups> @<SbeGroupV1> * ;
          <var_data_fields> @<SbeFieldV1> *
       ) ;
       rdf:type [ <SbeBlockV1Mixin> ] ?
    )
}

<SbeBlockV2Mixin> {
    (  $<SbeBlockV2Mixin_tes> (  <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <block_length> @linkml:Integer ? ;
          <alignment> @linkml:Integer ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <block_fields> @<SbeFieldV2> * ;
          <repeating_groups> @<SbeGroupV2> * ;
          <var_data_fields> @<SbeFieldV2> *
       ) ;
       rdf:type [ <SbeBlockV2Mixin> ] ?
    )
}

<SbeChoice> CLOSED {
    (  $<SbeChoice_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          schema1:description @linkml:String ? ;
          <bit_position> @linkml:Integer ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeChoice> ] ?
    )
}

<SbeCompositeV1> CLOSED {
    (  $<SbeCompositeV1_tes> (  &<SbeEncodingV1_tes> ;
          rdf:type [ <SbeEncodingV1> ] ? ;
          <composite_members> @<SbeMemberV1> +
       ) ;
       rdf:type [ <SbeCompositeV1> ] ?
    )
}

<SbeCompositeV2> CLOSED {
    (  $<SbeCompositeV2_tes> (  &<SbeMemberV2_tes> ;
          rdf:type [ <SbeMemberV2> ] ? ;
          &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <composite_members> @<SbeMemberV2> + ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeCompositeV2> ] ?
    )
}

<SbeElementV2>  (
    @<SbeMemberV2> OR @<SbeSimpleTypeV2>
)

<SbeElementV2_struct> {
    (  $<SbeElementV2_tes> (  <encoding_kind> @linkml:String ;
          <symbolic_name> @<SbeSymbolicName> ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <SbeElementV2> ] ?
    )
}

<SbeEncodingSetV1> CLOSED {
    (  $<SbeEncodingSetV1_tes> <encodings> @<SbeEncodingV1> + ;
       rdf:type [ <SbeEncodingSetV1> ] ?
    )
}

<SbeEncodingSetV2> CLOSED {
    (  $<SbeEncodingSetV2_tes> (  schema1:description @linkml:String ? ;
          <schema_package> @linkml:String ? ;
          <sbe_xml_base> @linkml:String ? ;
          <encodings> @<SbeElementV2> +
       ) ;
       rdf:type [ <SbeEncodingSetV2> ] ?
    )
}

<SbeEncodingV1>  (
    @<SbeCompositeV1> OR @<SbeEnumV1> OR @<SbeSetV1> OR @<SbeSimpleTypeV1>
)

<SbeEncodingV1_struct> {
    (  $<SbeEncodingV1_tes> (  &<SbeMemberV1_tes> ;
          rdf:type [ <SbeMemberV1> ] ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <SbeEncodingV1> ] ?
    )
}

<SbeEnumV1> CLOSED {
    (  $<SbeEnumV1_tes> (  &<SbeEncodingV1_tes> ;
          rdf:type [ <SbeEncodingV1> ] ? ;
          <encoding_type> @<SbeSymbolicName> ;
          <valid_values> @<SbeValidValue> +
       ) ;
       rdf:type [ <SbeEnumV1> ] ?
    )
}

<SbeEnumV2> CLOSED {
    (  $<SbeEnumV2_tes> (  &<SbeMemberV2_tes> ;
          rdf:type [ <SbeMemberV2> ] ? ;
          &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <encoding_type> @<SbeSymbolicName> ;
          <valid_values> @<SbeValidValue> + ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeEnumV2> ] ?
    )
}

<SbeFieldV1> CLOSED {
    (  $<SbeFieldV1_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <encoding_name> @<SbeSymbolicName> ;
          <offset> @linkml:Integer ? ;
          <presence> [ <https://w3id.org/lmodel/fix-sbe/SbePresence#required>
             <https://w3id.org/lmodel/fix-sbe/SbePresence#optional> <https://w3id.org/lmodel/fix-sbe/SbePresence#constant> ] ? ;
          <value_ref> @<SbeQualifiedName> ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <time_epoch> @linkml:String ? ;
          <time_unit> @linkml:String ? ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeFieldV1> ] ?
    )
}

<SbeFieldV2> CLOSED {
    (  $<SbeFieldV2_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <symbolic_name> @<SbeSymbolicName> ;
          <sbe_id> @linkml:Integer ;
          <encoding_name> @<SbeSymbolicName> ;
          <element_value> @<SbeToken> ? ;
          <offset> @linkml:Integer ? ;
          <alignment> @linkml:Integer ? ;
          <presence> [ <https://w3id.org/lmodel/fix-sbe/SbePresence#required>
             <https://w3id.org/lmodel/fix-sbe/SbePresence#optional> <https://w3id.org/lmodel/fix-sbe/SbePresence#constant> ] ? ;
          <null_value> @linkml:String ? ;
          <min_value> @linkml:String ? ;
          <max_value> @linkml:String ? ;
          <value_ref> @<SbeQualifiedName> ? ;
          <semantic_type> @<SbeToken> ? ;
          schema1:description @linkml:String ? ;
          <since_version> @linkml:Integer ? ;
          <deprecated_since> @linkml:Integer ?
       ) ;
       rdf:type [ <SbeFieldV2> ] ?
    )
}

<SbeGroupV1> CLOSED {
    (  $<SbeGroupV1_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
