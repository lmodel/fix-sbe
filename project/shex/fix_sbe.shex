<SbeValidValue> CLOSED {
    (  $<SbeValidValue_tes> (  &<SbeVersionedMixin_tes> ;
          rdf:type [ <SbeVersionedMixin> ] ? ;
          <symbolic_name> @<SbeSymbolicName> ;
